# API settings
API_V1_STR=/api
PORT=5000

# Security
SECRET_KEY=your-secret-key-here-at-least-32-chars
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=24h
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# CORS allowed origins - comma separated list
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Node environment
NODE_ENV=development

# Database connections
# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=passport_system

# MongoDB
MONGODB_URI=mongodb://localhost:27017/passport-system

# Email settings
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Passport Management System

# Alternative email config
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=user@example.com
EMAIL_PASSWORD=your-password
EMAIL_FROM=noreply@passport-system.com

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///passport_app.db

# SMS Config
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-twilio-sid
SMS_AUTH_TOKEN=your-twilio-token
SMS_PHONE_NUMBER=+11234567890

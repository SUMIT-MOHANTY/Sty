# API Settings
PROJECT_NAME=Passport Management System

# Security Settings
SECRET_KEY=your-secret-key-replace-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
JWT_ALGORITHM=HS256

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=passport_system

# CORS Settings
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Email Settings
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME=Passport Management System

# File Storage Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880  # 5MB
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
